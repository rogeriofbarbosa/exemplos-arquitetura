@startuml

set separator none
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Component,Proposto,Generico
  .Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28= {
    BackgroundColor: #5f5e5a;
    LineColor: #42413e;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Component,Proposto,Principal
  .Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sUHJpbmNpcGFs {
    BackgroundColor: #534ab7;
    LineColor: #3a3380;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Component,Proposto,Suporte
  .Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sU3Vwb3J0ZQ== {
    BackgroundColor: #0f6e56;
    LineColor: #0a4d3c;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship,Dependencia
  .Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh {
    LineThickness: 2;
    LineStyle: 0;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // API
  .Boundary-QVBJ {
    BackgroundColor: #ffffff;
    LineColor: #285673;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Plataforma Exemplo
  .Boundary-UGxhdGFmb3JtYSBFeGVtcGxv {
    BackgroundColor: #ffffff;
    LineColor: #204764;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // transparent element for relationships in legend
  .Element-Transparent {
    BackgroundColor: transparent;
    LineColor: transparent;
    FontColor: transparent;
  }
</style>

rectangle "==Component, Proposto, Generico" <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28=>>

rectangle "==Component, Proposto, Principal" <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sUHJpbmNpcGFs>>

rectangle "==Component, Proposto, Suporte" <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sU3Vwb3J0ZQ==>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Dependencia"

@enduml