@startuml
title <size:24>Component View: Plataforma Exemplo - API</size>\n<size:24>O que cada componente de domínio usa fora da API (banco, relatórios e sistemas externos). As dependências entre componentes estão na visão DominiosComponentes.</size>

set separator none
left to right direction
skinparam ranksep 40
skinparam nodesep 12
hide stereotype

skinparam {
  nodesep 40
  ranksep 90
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Component,Proposto,Generico
  .Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28= {
    BackgroundColor: #5f5e5a;
    LineColor: #42413e;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Component,Proposto,Principal
  .Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sUHJpbmNpcGFs {
    BackgroundColor: #534ab7;
    LineColor: #3a3380;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Component,Proposto,Suporte
  .Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sU3Vwb3J0ZQ== {
    BackgroundColor: #0f6e56;
    LineColor: #0a4d3c;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #3a7ca5;
    LineColor: #285673;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Banco
  .Element-RWxlbWVudCxDb250YWluZXIsQmFuY28= {
    BackgroundColor: #3a7ca5;
    LineColor: #285673;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,Externo
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw== {
    BackgroundColor: #8d99ae;
    LineColor: #626b79;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,Externo,Futuro
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubyxGdXR1cm8= {
    BackgroundColor: #8d99ae;
    LineColor: #626b79;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // API
  .Boundary-QVBJ {
    BackgroundColor: #ffffff;
    LineColor: #285673;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Plataforma Exemplo
  .Boundary-UGxhdGFmb3JtYSBFeGVtcGxv {
    BackgroundColor: #ffffff;
    LineColor: #204764;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "==Provedor de mensageria\n<size:16>[Software System]</size>\n\nCanal de conversa com os usuários (chat). O número é transporte, não identidade." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as Provedordemensageria
rectangle "==Provedor de e-mail\n<size:16>[Software System]</size>\n\nE-mail transacional (convites, avisos)." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as Provedordeemail
rectangle "==Armazenamento de objetos\n<size:16>[Software System]</size>\n\nArquivos e evidências por tenant." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as Armazenamentodeobjetos
rectangle "==Provedor de IA\n<size:16>[Software System]</size>\n\nModelo de linguagem e transcrição de voz, atrás de uma porta (adaptador trocável)." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as ProvedordeIA
rectangle "==Provedor de identidade corporativa\n<size:16>[Software System]</size>\n\nSSO da empresa cliente (OIDC ou SAML). Planejado; ainda não integrado no exemplo." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubyxGdXR1cm8=>> as Provedordeidentidadecorporativa

rectangle "Plataforma Exemplo\n<size:16>[Software System]</size>" <<Boundary-UGxhdGFmb3JtYSBFeGVtcGxv>> {
  rectangle "API\n<size:16>[Container: Node.js, TypeScript, ORM]</size>" <<Boundary-QVBJ>> {
    rectangle "==Coleta de dados\n<size:16>[Component: Módulo de domínio principal]</size>\n\nConvites, formulários e respostas; agregação com piso mínimo de participantes." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sUHJpbmNpcGFs>> as PlataformaExemplo.API.Coletadedados
    rectangle "==Análise\n<size:16>[Component: Módulo de domínio principal]</size>\n\nTransforma o que foi coletado em achados priorizados, com apoio de IA." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sUHJpbmNpcGFs>> as PlataformaExemplo.API.Análise
    rectangle "==Planos e acompanhamento\n<size:16>[Component: Módulo de domínio principal]</size>\n\nPlanos de ação, responsáveis, prazos, evidências e revisão." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sUHJpbmNpcGFs>> as PlataformaExemplo.API.Planoseacompanhamento
    rectangle "==Cadastro organizacional\n<size:16>[Component: Módulo de domínio de suporte]</size>\n\nEmpresa, unidades, áreas, grupos e pessoas." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sU3Vwb3J0ZQ==>> as PlataformaExemplo.API.Cadastroorganizacional
    rectangle "==Atendimento\n<size:16>[Component: Módulo de domínio de suporte]</size>\n\nSolicitações dos clientes e seu tratamento." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sU3Vwb3J0ZQ==>> as PlataformaExemplo.API.Atendimento
    rectangle "==Identidade e acesso\n<size:16>[Component: Módulo genérico]</size>\n\nUsuário, papel, sessão, MFA." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28=>> as PlataformaExemplo.API.Identidadeeacesso
    rectangle "==Privacidade e consentimento\n<size:16>[Component: Módulo genérico]</size>\n\nTermos, política e aceite." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28=>> as PlataformaExemplo.API.Privacidadeeconsentimento
    rectangle "==Registro de auditoria\n<size:16>[Component: Módulo genérico]</size>\n\nQuem fez o quê e quando; usado por todos." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28=>> as PlataformaExemplo.API.Registrodeauditoria
    rectangle "==Notificações\n<size:16>[Component: Módulo genérico]</size>\n\nAvisos por e-mail e por mensageria." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28=>> as PlataformaExemplo.API.Notificações
  }

  rectangle "==Serviço de relatórios\n<size:16>[Container: Python, FastAPI]</size>\n\nRenderiza PDFs a partir dos dados que a API monta. Roda na mesma imagem da API, em porta interna." <<Element-RWxlbWVudCxDb250YWluZXI=>> as PlataformaExemplo.Serviçoderelatórios
  database "==Banco de dados\n<size:16>[Container: PostgreSQL]</size>\n\nSistema de registro. Isolamento por tenant com Row-Level Security; trilha de auditoria append-only." <<Element-RWxlbWVudCxDb250YWluZXIsQmFuY28=>> as PlataformaExemplo.Bancodedados
}

PlataformaExemplo.API.Coletadedados --> PlataformaExemplo.Bancodedados <<Relationship-UmVsYXRpb25zaGlw>> : "Lê e grava o seu dado\n<size:16>[SQL, com RLS]</size>"
PlataformaExemplo.API.Análise --> PlataformaExemplo.Bancodedados <<Relationship-UmVsYXRpb25zaGlw>> : "Lê e grava o seu dado\n<size:16>[SQL, com RLS]</size>"
PlataformaExemplo.API.Planoseacompanhamento --> PlataformaExemplo.Bancodedados <<Relationship-UmVsYXRpb25zaGlw>> : "Lê e grava o seu dado\n<size:16>[SQL, com RLS]</size>"
PlataformaExemplo.API.Cadastroorganizacional --> PlataformaExemplo.Bancodedados <<Relationship-UmVsYXRpb25zaGlw>> : "Lê e grava o seu dado\n<size:16>[SQL, com RLS]</size>"
PlataformaExemplo.API.Atendimento --> PlataformaExemplo.Bancodedados <<Relationship-UmVsYXRpb25zaGlw>> : "Lê e grava o seu dado\n<size:16>[SQL, com RLS]</size>"
PlataformaExemplo.API.Identidadeeacesso --> PlataformaExemplo.Bancodedados <<Relationship-UmVsYXRpb25zaGlw>> : "Lê e grava o seu dado\n<size:16>[SQL, com RLS]</size>"
PlataformaExemplo.API.Privacidadeeconsentimento --> PlataformaExemplo.Bancodedados <<Relationship-UmVsYXRpb25zaGlw>> : "Lê e grava o seu dado\n<size:16>[SQL, com RLS]</size>"
PlataformaExemplo.API.Registrodeauditoria --> PlataformaExemplo.Bancodedados <<Relationship-UmVsYXRpb25zaGlw>> : "Grava a trilha\n<size:16>[SQL, append-only]</size>"
PlataformaExemplo.API.Notificações --> PlataformaExemplo.Bancodedados <<Relationship-UmVsYXRpb25zaGlw>> : "Grava os envios\n<size:16>[SQL, com RLS]</size>"
PlataformaExemplo.API.Análise --> PlataformaExemplo.Serviçoderelatórios <<Relationship-UmVsYXRpb25zaGlw>> : "Pede o PDF da análise\n<size:16>[HTTP interno]</size>"
PlataformaExemplo.API.Planoseacompanhamento --> PlataformaExemplo.Serviçoderelatórios <<Relationship-UmVsYXRpb25zaGlw>> : "Pede o PDF do plano\n<size:16>[HTTP interno]</size>"
PlataformaExemplo.API.Planoseacompanhamento --> Armazenamentodeobjetos <<Relationship-UmVsYXRpb25zaGlw>> : "Guarda as evidências\n<size:16>[SDK]</size>"
PlataformaExemplo.API.Análise --> ProvedordeIA <<Relationship-UmVsYXRpb25zaGlw>> : "Síntese e priorização\n<size:16>[HTTPS]</size>"
PlataformaExemplo.API.Coletadedados --> ProvedordeIA <<Relationship-UmVsYXRpb25zaGlw>> : "Transcreve respostas por voz\n<size:16>[HTTPS]</size>"
PlataformaExemplo.API.Notificações --> Provedordeemail <<Relationship-UmVsYXRpb25zaGlw>> : "Envia e-mail\n<size:16>[HTTPS]</size>"
PlataformaExemplo.API.Notificações --> Provedordemensageria <<Relationship-UmVsYXRpb25zaGlw>> : "Envia mensagens\n<size:16>[API REST]</size>"
PlataformaExemplo.API.Identidadeeacesso --> Provedordeidentidadecorporativa <<Relationship-UmVsYXRpb25zaGlw>> : "Federa a autenticação (planejado)\n<size:16>[OIDC]</size>"

@enduml