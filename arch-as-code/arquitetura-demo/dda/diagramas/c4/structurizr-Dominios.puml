</style>

rectangle "==Coleta de dados\n<size:16>[Domínio principal]</size>\n\nConvites, formulários e respostas; agregação com piso mínimo de participantes." <<Element-RWxlbWVudCxQcmluY2lwYWw=>> as 88
rectangle "==Análise\n<size:16>[Domínio principal]</size>\n\nAchados priorizados a partir do que foi coletado." <<Element-RWxlbWVudCxQcmluY2lwYWw=>> as 89
rectangle "==Planos e acompanhamento\n<size:16>[Domínio principal]</size>\n\nPlanos de ação, responsáveis, prazos, evidências e revisão." <<Element-RWxlbWVudCxQcmluY2lwYWw=>> as 90
rectangle "==Cadastro organizacional\n<size:16>[Domínio de suporte]</size>\n\nEmpresa, unidades, áreas, grupos e pessoas." <<Element-RWxlbWVudCxTdXBvcnRl>> as 91
rectangle "==Atendimento\n<size:16>[Domínio de suporte]</size>\n\nSolicitações dos clientes e seu tratamento." <<Element-RWxlbWVudCxTdXBvcnRl>> as 92
rectangle "==Identidade e acesso\n<size:16>[Domínio genérico]</size>\n\nUsuário, papel, sessão." <<Element-RWxlbWVudCxHZW5lcmljbw==>> as 93
rectangle "==Privacidade e consentimento\n<size:16>[Domínio genérico]</size>\n\nTermos, política e aceite." <<Element-RWxlbWVudCxHZW5lcmljbw==>> as 94
rectangle "==Registro de auditoria\n<size:16>[Domínio genérico]</size>\n\nQuem fez o quê e quando." <<Element-RWxlbWVudCxHZW5lcmljbw==>> as 95
rectangle "==Notificações\n<size:16>[Domínio genérico]</size>\n\nAvisos por e-mail e por mensageria." <<Element-RWxlbWVudCxHZW5lcmljbw==>> as 96
rectangle "==Gestão de pessoas do cliente\n<size:16>[Domínio vizinho]</size>\n\nSistemas de RH da empresa cliente; fornece a estrutura e as pessoas." <<Element-RWxlbWVudCxWaXppbmhv>> as 97

88 --> 91 <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Público e recortes"
89 --> 91 <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Grupos analisados"
90 --> 91 <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Responsáveis e áreas"
92 --> 91 <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Empresa e solicitante"
94 --> 93 <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Titular do aceite"
97 --> 91 <<Relationship-UmVsYXRpb25zaGlwLEZhdG8=>> : "Fornece estrutura e pessoas (importação)"
89 --> 88 <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Recebe os dados agregados"
90 --> 89 <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Recebe os achados priorizados"

@enduml