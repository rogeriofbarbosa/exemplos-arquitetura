  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #1f3a5f;
    LineColor: #152842;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Plataforma Exemplo
  .Boundary-UGxhdGFmb3JtYSBFeGVtcGxv {
    BackgroundColor: #ffffff;
