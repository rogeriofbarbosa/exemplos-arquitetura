@startuml
title <size:24>Container View: Plataforma Exemplo</size>\n<size:24>Os cinco contêineres e quem os usa. As integrações externas estão na visão Integracoes.</size>

set separator none
left to right direction
skinparam ranksep 40
skinparam nodesep 12
hide stereotype

skinparam {
  nodesep 40
  ranksep 90
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #3a7ca5;
    LineColor: #285673;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Banco
  .Element-RWxlbWVudCxDb250YWluZXIsQmFuY28= {
    BackgroundColor: #3a7ca5;
    LineColor: #285673;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Movel
  .Element-RWxlbWVudCxDb250YWluZXIsTW92ZWw= {
    BackgroundColor: #3a7ca5;
    LineColor: #285673;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Navegador
  .Element-RWxlbWVudCxDb250YWluZXIsTmF2ZWdhZG9y {
    BackgroundColor: #3a7ca5;
    LineColor: #285673;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
