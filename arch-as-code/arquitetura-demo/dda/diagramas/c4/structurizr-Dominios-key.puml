@startuml

set separator none
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Generico
  .Element-RWxlbWVudCxHZW5lcmljbw== {
    BackgroundColor: #5f5e5a;
    LineColor: #42413e;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Principal
  .Element-RWxlbWVudCxQcmluY2lwYWw= {
    BackgroundColor: #534ab7;
    LineColor: #3a3380;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Suporte
  .Element-RWxlbWVudCxTdXBvcnRl {
    BackgroundColor: #0f6e56;
    LineColor: #0a4d3c;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Vizinho
  .Element-RWxlbWVudCxWaXppbmhv {
    BackgroundColor: #f1efe8;
    LineColor: #a8a7a2;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #444441;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship,Dependencia
  .Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh {
    LineThickness: 2;
    LineStyle: 0;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Fato
  .Relationship-UmVsYXRpb25zaGlwLEZhdG8= {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // transparent element for relationships in legend
  .Element-Transparent {
    BackgroundColor: transparent;
    LineColor: transparent;
    FontColor: transparent;
  }
</style>

rectangle "==Generico" <<Element-RWxlbWVudCxHZW5lcmljbw==>>

rectangle "==Principal" <<Element-RWxlbWVudCxQcmluY2lwYWw=>>

rectangle "==Suporte" <<Element-RWxlbWVudCxTdXBvcnRl>>

rectangle "==Vizinho" <<Element-RWxlbWVudCxWaXppbmhv>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Dependencia"

rectangle "." <<.Element-Transparent>> as 2
2 --> 2 <<Relationship-UmVsYXRpb25zaGlwLEZhdG8=>> : "Fato"

@enduml