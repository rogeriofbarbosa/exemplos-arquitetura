@startuml
title <size:24>Component View: Plataforma Exemplo - API</size>\n<size:24>Os domínios como componentes da API e as dependências entre eles.</size>

set separator none
top to bottom direction
skinparam ranksep 32
skinparam nodesep 11
hide stereotype

skinparam {
  nodesep 40
  ranksep 80
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Component,Proposto,Generico
  .Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28= {
    BackgroundColor: #5f5e5a;
    LineColor: #42413e;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Component,Proposto,Principal
  .Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sUHJpbmNpcGFs {
    BackgroundColor: #534ab7;
    LineColor: #3a3380;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Component,Proposto,Suporte
  .Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sU3Vwb3J0ZQ== {
    BackgroundColor: #0f6e56;
    LineColor: #0a4d3c;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship,Dependencia
  .Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh {
    LineThickness: 2;
    LineStyle: 0;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // API
  .Boundary-QVBJ {
    BackgroundColor: #ffffff;
    LineColor: #285673;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Plataforma Exemplo
  .Boundary-UGxhdGFmb3JtYSBFeGVtcGxv {
    BackgroundColor: #ffffff;
    LineColor: #204764;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Plataforma Exemplo\n<size:16>[Software System]</size>" <<Boundary-UGxhdGFmb3JtYSBFeGVtcGxv>> {
  rectangle "API\n<size:16>[Container: Node.js, TypeScript, ORM]</size>" <<Boundary-QVBJ>> {
    rectangle "==Coleta de dados\n<size:16>[Component: Módulo de domínio principal]</size>\n\nConvites, formulários e respostas; agregação com piso mínimo de participantes." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sUHJpbmNpcGFs>> as PlataformaExemplo.API.Coletadedados
    rectangle "==Análise\n<size:16>[Component: Módulo de domínio principal]</size>\n\nTransforma o que foi coletado em achados priorizados, com apoio de IA." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sUHJpbmNpcGFs>> as PlataformaExemplo.API.Análise
    rectangle "==Planos e acompanhamento\n<size:16>[Component: Módulo de domínio principal]</size>\n\nPlanos de ação, responsáveis, prazos, evidências e revisão." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sUHJpbmNpcGFs>> as PlataformaExemplo.API.Planoseacompanhamento
    rectangle "==Cadastro organizacional\n<size:16>[Component: Módulo de domínio de suporte]</size>\n\nEmpresa, unidades, áreas, grupos e pessoas." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sU3Vwb3J0ZQ==>> as PlataformaExemplo.API.Cadastroorganizacional
    rectangle "==Atendimento\n<size:16>[Component: Módulo de domínio de suporte]</size>\n\nSolicitações dos clientes e seu tratamento." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sU3Vwb3J0ZQ==>> as PlataformaExemplo.API.Atendimento
    rectangle "==Identidade e acesso\n<size:16>[Component: Módulo genérico]</size>\n\nUsuário, papel, sessão, MFA." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28=>> as PlataformaExemplo.API.Identidadeeacesso
    rectangle "==Privacidade e consentimento\n<size:16>[Component: Módulo genérico]</size>\n\nTermos, política e aceite." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28=>> as PlataformaExemplo.API.Privacidadeeconsentimento
    rectangle "==Registro de auditoria\n<size:16>[Component: Módulo genérico]</size>\n\nQuem fez o quê e quando; usado por todos." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28=>> as PlataformaExemplo.API.Registrodeauditoria
    rectangle "==Notificações\n<size:16>[Component: Módulo genérico]</size>\n\nAvisos por e-mail e por mensageria." <<Element-RWxlbWVudCxDb21wb25lbnQsUHJvcG9zdG8sR2VuZXJpY28=>> as PlataformaExemplo.API.Notificações
  }

}

PlataformaExemplo.API.Análise --> PlataformaExemplo.API.Coletadedados <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Recebe os dados agregados\n<size:16>[Chamada em processo]</size>"
PlataformaExemplo.API.Planoseacompanhamento --> PlataformaExemplo.API.Análise <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Recebe os achados priorizados\n<size:16>[Chamada em processo]</size>"
PlataformaExemplo.API.Coletadedados --> PlataformaExemplo.API.Cadastroorganizacional <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Público e recortes\n<size:16>[Chamada em processo]</size>"
PlataformaExemplo.API.Análise --> PlataformaExemplo.API.Cadastroorganizacional <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Grupos analisados\n<size:16>[Chamada em processo]</size>"
PlataformaExemplo.API.Planoseacompanhamento --> PlataformaExemplo.API.Cadastroorganizacional <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Responsáveis e áreas\n<size:16>[Chamada em processo]</size>"
PlataformaExemplo.API.Atendimento --> PlataformaExemplo.API.Cadastroorganizacional <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Empresa e solicitante\n<size:16>[Chamada em processo]</size>"
PlataformaExemplo.API.Privacidadeeconsentimento --> PlataformaExemplo.API.Identidadeeacesso <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Titular do aceite\n<size:16>[Chamada em processo]</size>"
PlataformaExemplo.API.Coletadedados --> PlataformaExemplo.API.Notificações <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Convites\n<size:16>[Chamada em processo]</size>"
PlataformaExemplo.API.Planoseacompanhamento --> PlataformaExemplo.API.Notificações <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Lembretes de prazo\n<size:16>[Chamada em processo]</size>"
PlataformaExemplo.API.Atendimento --> PlataformaExemplo.API.Notificações <<Relationship-UmVsYXRpb25zaGlwLERlcGVuZGVuY2lh>> : "Avisos de andamento\n<size:16>[Chamada em processo]</size>"

@enduml