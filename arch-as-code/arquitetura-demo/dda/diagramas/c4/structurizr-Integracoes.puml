@startuml
title <size:24>Container View: Plataforma Exemplo</size>\n<size:24>A API e os sistemas externos com que ela fala, um por integração.</size>

set separator none
left to right direction
skinparam ranksep 40
skinparam nodesep 12
hide stereotype

skinparam {
  nodesep 40
  ranksep 90
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #3a7ca5;
    LineColor: #285673;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #1f3a5f;
    LineColor: #152842;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,Externo
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw== {
    BackgroundColor: #8d99ae;
    LineColor: #626b79;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,Externo,Futuro
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubyxGdXR1cm8= {
    BackgroundColor: #8d99ae;
    LineColor: #626b79;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Plataforma Exemplo
  .Boundary-UGxhdGFmb3JtYSBFeGVtcGxv {
    BackgroundColor: #ffffff;
    LineColor: #204764;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

person "==Gestor do cliente\n<size:16>[Person]</size>\n\nAdministra a conta da empresa cliente: estrutura, usuários e ciclos de trabalho." <<Element-RWxlbWVudCxQZXJzb24=>> as Gestordocliente
rectangle "==Provedor de mensageria\n<size:16>[Software System]</size>\n\nCanal de conversa com os usuários (chat). O número é transporte, não identidade." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as Provedordemensageria
rectangle "==Provedor de e-mail\n<size:16>[Software System]</size>\n\nE-mail transacional (convites, avisos)." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as Provedordeemail
rectangle "==Armazenamento de objetos\n<size:16>[Software System]</size>\n\nArquivos e evidências por tenant." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as Armazenamentodeobjetos
rectangle "==Provedor de IA\n<size:16>[Software System]</size>\n\nModelo de linguagem e transcrição de voz, atrás de uma porta (adaptador trocável)." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as ProvedordeIA
rectangle "==Provedor de identidade corporativa\n<size:16>[Software System]</size>\n\nSSO da empresa cliente (OIDC ou SAML). Planejado; ainda não integrado no exemplo." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubyxGdXR1cm8=>> as Provedordeidentidadecorporativa

rectangle "Plataforma Exemplo\n<size:16>[Software System]</size>" <<Boundary-UGxhdGFmb3JtYSBFeGVtcGxv>> {
  rectangle "==API\n<size:16>[Container: Node.js, TypeScript, ORM]</size>\n\nAutenticação, regras de negócio, isolamento por tenant, integrações e montagem dos dados dos relatórios." <<Element-RWxlbWVudCxDb250YWluZXI=>> as PlataformaExemplo.API
}

Gestordocliente --> Provedordemensageria <<Relationship-UmVsYXRpb25zaGlw>> : "Conversa com o assistente\n<size:16>[Chat]</size>"
PlataformaExemplo.API --> Provedordemensageria <<Relationship-UmVsYXRpb25zaGlw>> : "Envia mensagens\n<size:16>[API REST]</size>"
Provedordemensageria --> PlataformaExemplo.API <<Relationship-UmVsYXRpb25zaGlw>> : "Entrega as mensagens recebidas\n<size:16>[Webhook]</size>"
PlataformaExemplo.API --> Provedordeemail <<Relationship-UmVsYXRpb25zaGlw>> : "Envia e-mail\n<size:16>[HTTPS]</size>"
PlataformaExemplo.API --> Armazenamentodeobjetos <<Relationship-UmVsYXRpb25zaGlw>> : "Guarda e lê arquivos\n<size:16>[SDK]</size>"
PlataformaExemplo.API --> ProvedordeIA <<Relationship-UmVsYXRpb25zaGlw>> : "Chama o modelo e transcreve voz\n<size:16>[HTTPS]</size>"
PlataformaExemplo.API --> Provedordeidentidadecorporativa <<Relationship-UmVsYXRpb25zaGlw>> : "Federa a autenticação (planejado)\n<size:16>[OIDC]</size>"

@enduml